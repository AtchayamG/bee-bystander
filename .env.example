# Bee Wearable Developer API Configuration
# Preferred local development: run the official Bee CLI's `bee proxy` after `bee login`.
# The proxy uses CLI authentication; do not export its credential into this file.
# BEE_TOKEN is optional and only for direct HTTPS API access; leave blank for proxy mode.
BEE_TOKEN=
BEE_API_BASE=http://127.0.0.1:8787
# To use direct HTTPS instead, set BEE_API_BASE=https://app-api-developer.ce.bee.amazon.dev.
PORT=3002
